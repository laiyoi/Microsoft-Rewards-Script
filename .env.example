# Example .env for docker-compose / dotenv usage (V4-china branch)
# Clash control API (replace with your router/docker host)
CLASH_API=http://192.168.1.1:9090
# Optional secret for Clash API (if configured)
CLASH_SECRET=

# Option A (preferred for many accounts): provide ACCOUNTS as newline-separated entries.
# Each entry is a semicolon-separated list of key=value pairs.
# Supported keys: id, cookie, region, proxyGroup, panelUrl
# Example (multiple lines allowed):
# ACCOUNTS="id=acct1;cookie=ltoken=xxx;region=cn;proxyGroup=微软服务-acct1\nid=acct2;cookie=ltoken=yyy;panelUrl=http://192.168.1.3:4000/panel/acct2;proxyGroup=微软服务-acct2"
# Note: when using a .env file, keep entries on one line with embedded \n as shown above or use docker-compose env_file multiline support.

# Option B (single-file mount): point to a mounted accounts.json (legacy/optional)
# ACCOUNTS_FILE=/app/config/accounts.json

# Mapping from region code to Clash node name. JSON string.
# For 'cn' use "DIRECT" to indicate no proxy (direct connection).
# Example: {"cn":"DIRECT","us":"US-Node","jp":"JP-Node","hk":"HK-Node"}
REGION_MAP={}

# Prefix used to compute proxy group name if account.proxyGroup not present
GROUP_PREFIX=微软服务

# Optional: per-account panel URL field name in accounts.json is `panelUrl`.
# If present, the sync script will try to fetch the mihomo control panel page
# for each account and detect the region by matching keywords in the page body.
# REGION_KEYWORDS should be a JSON object mapping region code to an array of
# case-insensitive keywords to match. The script scans the panel HTML/text for
# these words and assigns the first matching region.
# Example:
REGION_KEYWORDS={"us":["us","usa","america","美服","美国","北美","na"],"hk":["hk","hk_gbl","hongkong","香港"],"cn":["cn","china","中国","大陆","国内", "直连"],"jp":["jp","japan","日本"],"kr":["kr","korea","韩国"],"tw":["tw","taiwan","台湾"],"os":["os","overseas","海外","国际"]}

#REGION_KEYWORDS={}

# Prefix used to compute proxy group name if account.proxyGroup not present
GROUP_PREFIX=微软服务-

# Optional timeout (ms) for panel detection and Clash API calls
HTTP_TIMEOUT=5000
