# Example .env for docker-compose / dotenv usage
# Clash control API (replace with your router/docker host)
CLASH_API=http://192.168.1.1:9090
# Optional secret for Clash API (if configured)
CLASH_SECRET=

# Either provide a subscription URL that lists account cookies/tokens
MIHOMO_SUB=
# Or mount an accounts.json and point to it
ACCOUNTS_FILE=./config/accounts.json

# Mapping from region code to Clash node name. JSON string.
# Example: {"cn":"CN-Node","us":"US-Node","jp":"JP-Node","tw":"TW-Node"}
REGION_MAP={}

# Prefix used to compute proxy group name if account.proxyGroup not present
GROUP_PREFIX=微软服务-
