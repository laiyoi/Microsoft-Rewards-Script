# Example .env — account credentials + Clash region switching + control API
# Copy this file to .env and fill in your details.
# .env should be in your .gitignore, never commit your credentials!
#
# Add one numbered block per account. Slots may be skipped; for example,
# ACCOUNT_2 can be used even when ACCOUNT_1 is not configured.
#
# LANG_CODE accepts a BCP 47 language tag such as nl, it, or pt-BR.
# GEO_LOCALE accepts a two-letter country code. With auto, the Microsoft
# profile country is cached after a successful dashboard request and used for
# later browser fingerprints and request headers.
#
# REGION is optional and only used for Clash/mihomo proxy switching (see the
# "Clash region proxy" section below). Leave it unset to disable switching.

# ── Account 1 ─────────────────────────────────────────────────────────
ACCOUNT_1_EMAIL=email@example.com
# Optional. Leave unset for passwordless/Authenticator-only accounts.
#ACCOUNT_1_PASSWORD=your_password
#ACCOUNT_1_TOTP_SECRET=
#ACCOUNT_1_RECOVERY_EMAIL=
# 国内账号推荐：GEO_LOCALE=CN、LANG_CODE=zh-CN（配合 china 热搜源）
ACCOUNT_1_LANG_CODE=zh-CN
ACCOUNT_1_GEO_LOCALE=CN
# 地区代理切换：设置后，处理该账户前会把 Clash 分组切到对应节点
#ACCOUNT_1_REGION=cn
# 可选：账户专用 selector 分组（覆盖 CLASH_PROXY_GROUP）
#ACCOUNT_1_PROXY_GROUP=
# Browser proxy: HTTP/HTTPS/SOCKS4/SOCKS5. SOCKS proxies must not require authentication.
# 路由器 Clash 透明代理时无需配置；仅在浏览器代理模式下指向 Clash mixed-port
#ACCOUNT_1_PROXY_HTTP=false
#ACCOUNT_1_PROXY_URL=http://192.168.1.1
#ACCOUNT_1_PROXY_PORT=7890
#ACCOUNT_1_PROXY_USERNAME=
#ACCOUNT_1_PROXY_PASSWORD=
ACCOUNT_1_SAVE_FINGERPRINT_MOBILE=true
ACCOUNT_1_SAVE_FINGERPRINT_DESKTOP=true

# ── Account 2 (duplicate and use any positive slot number for more) ───
#ACCOUNT_2_EMAIL=email_2@example.com
#ACCOUNT_2_PASSWORD=your_password
#ACCOUNT_2_TOTP_SECRET=
#ACCOUNT_2_RECOVERY_EMAIL=
#ACCOUNT_2_GEO_LOCALE=auto
#ACCOUNT_2_LANG_CODE=en
#ACCOUNT_2_REGION=us
#ACCOUNT_2_PROXY_GROUP=
#ACCOUNT_2_PROXY_HTTP=false
#ACCOUNT_2_PROXY_URL=
#ACCOUNT_2_PROXY_PORT=0
#ACCOUNT_2_PROXY_USERNAME=
#ACCOUNT_2_PROXY_PASSWORD=

# ── Clash / mihomo 地区代理切换（可选）────────────────────────────────
# 启用后，脚本会在处理每个账户前调用 Clash 控制 API，把 selector 分组
# 切换到该账户 ACCOUNT_N_REGION 对应的地区节点。
#
# 适用场景：
#   1) Clash 在路由器上做透明代理（TUN / redir / tproxy）：无需配置
#      ACCOUNT_N_PROXY_URL / PORT，切换分组即可改变出口。
#   2) 浏览器 / HTTP 请求走 Clash 的 mixed-port：把 ACCOUNT_N_PROXY_URL
#      和 ACCOUNT_N_PROXY_PORT 指向该端口。
#
# 启用方式：设置 CLASH_API（或显式 CLASH_ENABLED=true）。
# Clash 控制 API 地址（OpenClash / mihomo 的 external-controller）
#CLASH_API=http://192.168.1.1:9090
# 控制 API 密钥（Clash 配置了 secret 时填写）
#CLASH_SECRET=
# 需要切换的 selector 分组，必须是 Microsoft 流量实际命中的分组。
# 支持弱匹配：忽略大小写、emoji、空格和标点，配置 "微软服务" 也能命中
# "Ⓜ️ 微软服务"。
#CLASH_PROXY_GROUP=GLOBAL
#
# 地区代码 -> 节点名/关键字（一行 JSON 对象）。
# 值可以是完整节点名，也可以是逗号分隔的多个候选/关键字；例如：
#   "cn":"DIRECT"                         使用内置 DIRECT
#   "us":"美国,US,United States"          按关键字匹配 "🇺🇸 美国节点"
#   "hk":"🇭🇰 香港节点"                    直接指定节点名
# 没有配置映射的地区，会使用内置别名自动匹配，例如 us/美国/United States、
# hk/香港/Hong Kong、jp/日本/Japan、sg/新加坡、tw/台湾、kr/韩国 等。
# 节点名支持弱匹配：us 可命中 US01、US-Node，hk 可命中 HK01、香港节点。
#REGION_MAP={"cn":"DIRECT","us":"美国,US,United States","hk":"香港,Hong Kong,HK"}
#
# 追加自定义关键字（可选，会与内置别名合并）
#REGION_KEYWORDS={"us":["美区","美服","北美"],"hk":["港","深港"]}
#
# 控制 API 请求超时（毫秒）
#CLASH_TIMEOUT_MS=5000
# 切换后等待时间（毫秒），给 Clash 应用新节点留出时间
#CLASH_SWITCH_DELAY_MS=1000
# 切换后回读分组确认已生效
#CLASH_VERIFY=true
# 切换失败时是否让该账户直接失败；false 表示仅告警并沿用当前节点
#CLASH_STRICT=false
#
# 按账户配置（写在账号块中）：
#   ACCOUNT_N_REGION=us          # 地区代码；设置后才会触发切换
#   ACCOUNT_N_PROXY_GROUP=...    # 可选，覆盖全局 CLASH_PROXY_GROUP
#
# 注意：REGION_MAP / REGION_KEYWORDS 必须写成一行 JSON，且不要带行内注释；
# .env 解析器会把 # 之后的内容也当作值的一部分。

# ── Control API（API_MODE=true 时使用）────────────────────────────────
# See scripts/api/README.md for full documentation.
# Generate a token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#API_TOKEN=
